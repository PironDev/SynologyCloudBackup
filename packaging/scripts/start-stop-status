#!/bin/sh
# @DISPLAY@ — управление службой в DSM 7 (выполняется от пользователя пакета).
# Файл service.conf в каталоге var пакета (создаётся вручную) может переопределить:
#   WEB_ADDR=":8765"            # включить дополнительный прямой интерфейс с паролем
#   GATEWAY_ADDR="127.0.0.1:9001"
#   PROXY_ADDR="127.0.0.1:9002" # внутренний порт CGI-моста DSM (только localhost)
#   ALLOW_USERS="vasya,petya"   # пользователи DSM помимо администраторов ("*" — любые)
#   EXTRA_ARGS=""

PKG="@PKG@"
BIN_NAME="@BIN@"

TARGET="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"
PIDFILE="$VAR/$BIN_NAME.pid"
LOGFILE="$VAR/service.log"
DATA="$VAR/data"

pick_binary() {
	case "$(uname -m)" in
	x86_64 | amd64) suffix="amd64" ;;
	aarch64 | arm64 | armv8*) suffix="arm64" ;;
	armv7* | armhf) suffix="armv7" ;;
	*) return 1 ;;
	esac
	BIN="$TARGET/bin/$BIN_NAME-$suffix"
	[ -x "$BIN" ]
}

is_running() {
	[ -f "$PIDFILE" ] || return 1
	pid="$(cat "$PIDFILE" 2>/dev/null)"
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
	# защита от повторно использованного PID: процесс должен быть нашим
	case "$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')" in
	*"$BIN_NAME"*) return 0 ;;
	esac
	return 1
}

start() {
	if is_running; then
		return 0
	fi
	if ! pick_binary; then
		echo "Архитектура $(uname -m) не поддерживается или нет исполняемого файла" >>"$LOGFILE"
		return 1
	fi
	mkdir -p "$DATA" || return 1
	# простая ротация журнала службы
	if [ -f "$LOGFILE" ] && [ "$(wc -c <"$LOGFILE")" -gt 5242880 ]; then
		mv -f "$LOGFILE" "$LOGFILE.1"
	fi
	WEB_ADDR="@WEB_DEFAULT@"
	GATEWAY_ADDR=""
	PROXY_ADDR=""
	EXTRA_ARGS=""
	[ -f "$VAR/service.conf" ] && . "$VAR/service.conf"
	# Оконная сборка: прямой интерфейс выключен, вход только через DSM (CGI-мост).
	# Сборка -tab: прямой интерфейс с паролем на порту пакета.
	set -- -data "$DATA" -web "$WEB_ADDR"
	[ -n "$GATEWAY_ADDR" ] && set -- "$@" -gateway "$GATEWAY_ADDR"
	[ -n "$PROXY_ADDR" ] && set -- "$@" -proxy "$PROXY_ADDR"
	# shellcheck disable=SC2086
	nohup "$BIN" "$@" $EXTRA_ARGS >>"$LOGFILE" 2>&1 &
	echo $! >"$PIDFILE"
	sleep 1
	is_running
}

stop() {
	is_running || {
		rm -f "$PIDFILE"
		return 0
	}
	pid="$(cat "$PIDFILE")"
	kill -TERM "$pid" 2>/dev/null
	# Даём до 20 секунд на аккуратное завершение (остановка текущей выгрузки).
	i=0
	while kill -0 "$pid" 2>/dev/null && [ $i -lt 20 ]; do
		sleep 1
		i=$((i + 1))
	done
	kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
	rm -f "$PIDFILE"
	return 0
}

case "$1" in
start)
	start || exit 1
	;;
stop)
	stop
	;;
status)
	is_running || exit 3
	;;
log)
	echo "$LOGFILE"
	;;
*)
	echo "usage: $0 {start|stop|status}" >&2
	exit 1
	;;
esac
exit 0
