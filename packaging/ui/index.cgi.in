#!/bin/sh
# CGI-мост DSM → служба @DISPLAY@. Выполняется веб-сервером DSM при открытии
# /webman/3rdparty/@PKG@/index.cgi. Проверяет сессию DSM и передаёт запрос службе.
TARGET="/var/packages/@PKG@/target"
VAR="/var/packages/@PKG@/var"
ALLOW_USERS=""
[ -f "$VAR/service.conf" ] && . "$VAR/service.conf"
case "$(uname -m)" in
x86_64 | amd64) suffix="amd64" ;;
aarch64 | arm64 | armv8*) suffix="arm64" ;;
armv7* | armhf) suffix="armv7" ;;
*) suffix="" ;;
esac
BIN="$TARGET/bin/@BIN@-$suffix"
if [ -z "$suffix" ] || [ ! -x "$BIN" ]; then
	printf 'Status: 500 Internal Server Error\r\nContent-Type: application/json\r\n\r\n{"error":"не найден исполняемый файл для архитектуры %s"}' "$(uname -m)"
	exit 0
fi
exec "$BIN" -cgi -data "$VAR/data" -allow-users "$ALLOW_USERS"
